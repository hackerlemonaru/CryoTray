            <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A9AE8"/>
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E6FAE"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E5C91"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#2B88D8"/>
            <SolidColorBrush x:Key="CpuAccentBrush" Color="#4FC3F7"/>
            <SolidColorBrush x:Key="GpuAccentBrush" Color="#7CB342"/>
            <SolidColorBrush x:Key="RamAccentBrush" Color="#62B0E8"/>
            <SolidColorBrush x:Key="BatteryAccentBrush" Color="#F3C765"/>
            <SolidColorBrush x:Key="CoolingOnTextBrush" Color="#76C6ED"/>
            <SolidColorBrush x:Key="CoolingOffTextBrush" Color="#E5987E"/>
