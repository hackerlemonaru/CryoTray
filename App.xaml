<Application x:Class="CryoTray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="SegoeUIVariable">Segoe UI Variable Display, Segoe UI, Tahoma, Arial</FontFamily>
            <FontFamily x:Key="SegoeUIVariableText">Segoe UI Variable Text, Segoe UI, Tahoma, Arial</FontFamily>
            <SolidColorBrush x:Key="WindowBorderBrush" Color="#C26A47"/>

            <!-- Theme palette: replaced at runtime by ThemeService. -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#141414"/>
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#141414"/>
            <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1B1B1B"/>
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#242424"/>
            <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#262626"/>
            <SolidColorBrush x:Key="InsetBackgroundBrush" Color="#121212"/>
            <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#0D0D0D"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#262626"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#333333"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#383838"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#303030"/>
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="ActiveBackgroundBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextTitleBrush" Color="#D5D5D5"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#787878"/>
            <SolidColorBrush x:Key="TextDimBrush" Color="#A6A6A6"/>
            <SolidColorBrush x:Key="IconBrush" Color="#C4C4C4"/>
            <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#222222"/>
            <SolidColorBrush x:Key="TooltipBorderBrush" Color="#444444"/>
            <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="MenuBorderBrush" Color="#525252"/>
            <SolidColorBrush x:Key="MenuHoverBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="MenuHoverBorderBrush" Color="#6E6E6E"/>
            <SolidColorBrush x:Key="CheckboxBackgroundBrush" Color="#1A1A1A"/>
