<Window x:Class="CryoTray.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource System_Title}"
        Height="660" Width="434"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Images/CryoTray.ico"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="0"
        ResizeMode="NoResize"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="FanHealthIdleFilterStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="12,2,12,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="15" Height="15"
                                    Background="{DynamicResource CheckboxBackgroundBrush}"
                                    BorderBrush="{DynamicResource CheckboxBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M2,6 L5,9 L12,2"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.9"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#2B88D8"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#2B88D8"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#2B88D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FanHealthHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10,12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ActiveBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="#2B88D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <TextBlock Text="{DynamicResource System_Header}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyDiagnostics"
                            Click="BtnCopyDiagnostics_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentTextBrush}"
                            Cursor="Hand"
                            Padding="4"
                            Margin="0,0,12,0"
                            ToolTip="{DynamicResource System_CopyDiagnostics}"
                            AutomationProperties.Name="{DynamicResource System_CopyDiagnostics}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,2 L10,2 L10,9 M5,4 L12,4 L12,12 L5,12 Z"
                                  Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="1.15"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCopyDiagnostics"
                                       Text="{DynamicResource System_Copy}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSaveTo"
                            Click="BtnSaveTo_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentTextBrush}"
                            Cursor="Hand"
                            Padding="4"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,2 L11,2 L14,5 L14,14 L2,14 L2,2 Z M5,2 L5,6 L11,6 L11,2 M5,9 L11,9 L11,13 L5,13 Z"
                                  Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="1.15"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource System_SaveTo}" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnClose_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="5"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource System_CloseAutomation}">
                        <Path Data="M1,1 L10,10 M10,1 L1,10"
                              Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.3"
                              Width="11" Height="11"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Key-Value List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InfoContainer" Margin="12,8,12,8">
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Border>
</Window>
