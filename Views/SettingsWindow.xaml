<Window x:Class="CryoTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Height="620" Width="480"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Images/CryoTray.ico"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="0"
        ResizeMode="NoResize"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="18" Height="18"
                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M2,7 L6,11 L14,3"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2.1"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#2B88D8"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#2B88D8"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsDisclosureToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderSurface"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioOuter"
                                         Width="18" Height="18"
                                         Fill="Transparent"
                                         Stroke="{DynamicResource TextMutedBrush}"
                                         StrokeThickness="1.3"/>
                                <Ellipse x:Name="RadioInner"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource WindowBackgroundBrush}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioOuter" Property="Fill" Value="#2B88D8"/>
                                <Setter TargetName="RadioOuter" Property="Stroke" Value="#2B88D8"/>
                                <Setter TargetName="RadioInner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RadioOuter" Property="Stroke" Value="{DynamicResource TextTertiaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RadioOuter" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="RadioOuter" Property="StrokeThickness" Value="1.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBdr" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwatchBdr" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="SwatchBdr" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AutopilotRemoveButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RemoveBorder"
                                Background="Transparent"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveBorder" Property="Background" Value="{DynamicResource DangerSoftBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RemoveBorder" Property="Background" Value="{DynamicResource DangerSoftHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AutopilotToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="42" Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource BorderStrongBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="16" Height="16"
                                         Fill="{DynamicResource IconBrush}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2B88D8"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Template (Zero White Boxes) -->
        <ControlTemplate x:Key="SettingsDarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Background="{DynamicResource InputBackgroundBrush}"
                              BorderBrush="{DynamicResource BorderStrongBrush}"
                              BorderThickness="1"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Margin="8,0,2,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,28,0"/>

                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder"
                            Background="{DynamicResource PanelAltBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B88D8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource SettingsDarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="SettingsMiniComboStyle" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource SettingsDarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="4,8,4,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2B88D8"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsFooterButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="FooterBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterBorder" Property="Background" Value="{DynamicResource ActiveBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FooterBorder" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid Margin="24,14,20,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,21">
            <TextBlock Text="{DynamicResource Settings_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Settings_CloseAutomation}">
                <Path Data="M1,1 L10,10 M10,1 L1,10"
                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.3"
                      Width="11" Height="11" Stretch="Uniform"/>
            </Button>
        </Grid>

        <!-- Tab Bar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,20">
            <WrapPanel Orientation="Horizontal">
                <RadioButton x:Name="TabGeneral" Style="{StaticResource TabButtonStyle}" IsChecked="True" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabGeneral}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.3"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                            <Path Data="M8,0 L8,3 M8,13 L8,16 M0,8 L3,8 M13,8 L16,8 M2.3,2.3 L4.4,4.4 M11.6,11.6 L13.7,13.7 M13.7,2.3 L11.6,4.4 M4.4,11.6 L2.3,13.7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.2"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Settings_TabGeneral}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabView" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabView}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M1,3 L15,3 M4,1.5 L4,4.5 M1,8 L15,8 M11,6.5 L11,9.5 M1,13 L15,13 M6,11.5 L6,14.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.25" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_TabView}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabCpu" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabCpu}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M5,4 L11,4 L11,10 L5,10 Z M7,6 L9,6 L9,8 L7,8 Z M7,2 L7,4 M9,2 L9,4 M7,10 L7,12 M9,10 L9,12 M3,6 L5,6 M3,8 L5,8 M11,6 L13,6 M11,8 L13,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.15" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_TabCpu}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabMemory" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabMemory}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,5 L14,5 L14,11 L2,11 Z M4,11 L4,13.5 M6.5,11 L6.5,13.5 M9.5,11 L9.5,13.5 M12,11 L12,13.5 M4.5,7 L6.5,7 L6.5,9 L4.5,9 Z M9.5,7 L11.5,7 L11.5,9 L9.5,9 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.1" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_TabMemory}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabDisk" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabDisk}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,4 L14,4 L14,12 L2,12 Z M4,7 L12,7 L12,10 L4,10 Z M4,5 L6,5 M4,8 L6,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.15" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_TabDisk}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabGpu" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabGpu}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,4 L14,4 L14,11 L2,11 Z M4,13 L12,13 L12,14 L4,14 Z M5.5,7.5 A1.5,1.5 0 1,0 8.5,7.5 A1.5,1.5 0 1,0 5.5,7.5 Z M9.5,7.5 A1.5,1.5 0 1,0 12.5,7.5 A1.5,1.5 0 1,0 9.5,7.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.1" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_TabGpu}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabAutopilot" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabAutopilot}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9,1 L3,9 L7,9 L6,15 L13,6 L9,6 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.15" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_TabAutopilot}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabAbout" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked" AutomationProperties.Name="{DynamicResource Settings_TabAbout}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,1.5 A6.5,6.5 0 1,0 8,14.5 A6.5,6.5 0 1,0 8,1.5 M8,7 L8,11 M8,4.4 L8,4.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.2" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_TabAbout}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </WrapPanel>
        </Border>

        <!-- Missing PawnIO Driver Notice -->
        <Border x:Name="PawnIoSettingsBanner"
                Grid.Row="2"
                Background="{DynamicResource PawnIoBackgroundBrush}"
                BorderBrush="{DynamicResource PawnIoBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Settings_PawnIoMissing}"
                           Foreground="{DynamicResource PawnIoTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button x:Name="BtnSettingsInstallPawnIo"
                        Grid.Column="1"
                        Content="{DynamicResource Main_PawnIoAction}"
                        Click="BtnInstallPawnIo_Click"
                        Style="{StaticResource SettingsFooterButton}"
                        Background="{DynamicResource PawnIoButtonBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Main_PawnIoActionAutomation}"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer x:Name="SettingsContentScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- GENERAL TAB -->
                <StackPanel x:Name="PanelGeneral">
                    <!-- Language -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="126"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_Language}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="CmbLanguage" HorizontalAlignment="Left" Width="126" SelectionChanged="CmbLanguage_SelectionChanged">
                            <ComboBoxItem Content="English" IsSelected="True"/>
                            <ComboBoxItem Content="العربية"/>
                        </ComboBox>
                    </Grid>

                    <!-- Temperature Units -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="126"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_TemperatureUnits}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="CmbTempUnits" HorizontalAlignment="Left" Width="126" SelectionChanged="CmbTempUnits_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Settings_Celsius}" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource Settings_Fahrenheit}"/>
                        </ComboBox>
                    </Grid>

                    <!-- Notifications -->
                    <TextBlock Text="{DynamicResource Settings_Notifications}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkDisableAllNotifications" Content="{DynamicResource Settings_DisableAllNotifications}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <TextBlock Text="{DynamicResource Settings_DisableAllNotificationsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,2,0,10"/>

                    <!-- Temperature alerts are grouped here so the mute and test controls sit together. -->
                    <TextBlock Text="{DynamicResource Settings_TemperatureAlerts}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkMuteTemperatureAlerts" Content="{DynamicResource Settings_MuteAlerts}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <Button x:Name="BtnTestAlert" Content="{DynamicResource Settings_TestAlert}" Click="BtnTestAlert_Click" Style="{StaticResource SettingsFooterButton}" HorizontalAlignment="Left" Margin="0,4,0,6"/>
                    <CheckBox x:Name="ChkFanHealthAlerts" Content="{DynamicResource Settings_FanHealthAlerts}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <TextBlock Text="{DynamicResource Settings_FanHealthAlertsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,2,0,10"/>
                    <CheckBox x:Name="ChkGpuDeltaAlerts" Content="{DynamicResource Settings_GpuDeltaAlerts}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <TextBlock Text="{DynamicResource Settings_GpuDeltaAlertsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,2,0,8"/>
                    <TextBlock Text="{DynamicResource Settings_GpuDeltaThreshold}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="28,0,0,6"/>
                    <Grid Margin="28,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldGpuDeltaThreshold"
                                Minimum="15"
                                Maximum="40"
                                Value="25"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SldGpuDeltaThreshold_ValueChanged"
                                AutomationProperties.Name="{DynamicResource Settings_GpuDeltaThreshold}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtGpuDeltaThreshold" Text="25°C" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Checkboxes -->
                    <CheckBox x:Name="ChkShowComputerName" Content="{DynamicResource Settings_ShowComputerName}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkLaunchStartup" Content="{DynamicResource Settings_LaunchStartup}" Checked="ChkLaunchStartup_Changed" Unchecked="ChkLaunchStartup_Changed"/>
                    <CheckBox x:Name="ChkLaunchBackground" Content="{DynamicResource Settings_LaunchBackground}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkEnableCoolingOnLaunch" Content="{DynamicResource Settings_EnableCoolingOnLaunch}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkEnableCoolingOnBattery" Content="{DynamicResource Settings_EnableCoolingOnBattery}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkDisableCoolingOnExit" Content="{DynamicResource Settings_DisableCoolingOnExit}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkPinToTaskbar" Content="{DynamicResource Settings_PinToTaskbar}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkAlwaysOnTop" Content="{DynamicResource Settings_AlwaysOnTop}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkHideOnFocusLoss" Content="{DynamicResource Settings_HideOnFocusLoss}" Checked="SettingChanged" Unchecked="SettingChanged"/>

                    <!-- Hotkey combo -->
                    <CheckBox x:Name="ChkUseHotkey" Content="{DynamicResource Settings_UseHotkey}" Checked="ChkUseHotkey_Changed" Unchecked="ChkUseHotkey_Changed" Margin="0,12,0,6"/>
                    <StackPanel Margin="28,2,0,0">
                        <TextBox x:Name="TxtHotkeyShortcut"
                                 Text="Ctrl + Shift + C"
                                 IsReadOnly="True"
                                 ContextMenu="{x:Null}"
                                 Width="210" Height="30"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 BorderThickness="1"
                                 Padding="8,0"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 HorizontalAlignment="Left"
                                 Cursor="Hand"
                                 AutomationProperties.Name="{DynamicResource Settings_UseHotkey}"
                                 GotKeyboardFocus="TxtHotkeyShortcut_GotKeyboardFocus"
                                 LostKeyboardFocus="TxtHotkeyShortcut_LostKeyboardFocus"
                                 PreviewKeyDown="TxtHotkeyShortcut_PreviewKeyDown"/>
                        <TextBlock x:Name="TxtHotkeyHint"
                                   Text="{DynamicResource Settings_HotkeyHint}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Fan names (collapsed by default) -->
                    <ToggleButton x:Name="FanNamesToggle"
                                  Style="{StaticResource SettingsDisclosureToggleStyle}"
                                  IsChecked="False"
                                  Checked="FanNamesToggle_Changed"
                                  Unchecked="FanNamesToggle_Changed"
                                  Margin="0,16,0,0"
                                  AutomationProperties.Name="{DynamicResource Settings_FanNames}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtFanNamesChevron"
                                       Grid.Column="0"
                                       Text="›"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource Settings_FanNames}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ToggleButton>
                    <StackPanel x:Name="PnlFanNamesContent" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Settings_FanNamesDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel x:Name="PnlFanAliases" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- VIEW TAB -->
                <StackPanel x:Name="PanelView" Visibility="Collapsed">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="126"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_Theme}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbTheme"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Width="126"
                                  SelectionChanged="CmbTheme_SelectionChanged"
                                  AutomationProperties.Name="{DynamicResource Settings_Theme}">
                            <ComboBoxItem Content="{DynamicResource Theme_Dark}" Tag="Dark"/>
                            <ComboBoxItem Content="{DynamicResource Theme_Light}" Tag="Light"/>
                            <ComboBoxItem Content="{DynamicResource Theme_System}" Tag="System"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="{DynamicResource Settings_SystemTrayBadges}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkShowGpuBadge" Content="{DynamicResource Settings_ShowGpuBadge}" Checked="ChkTrayBadge_Changed" Unchecked="ChkTrayBadge_Changed" Margin="0,6,0,6"/>
                    <StackPanel x:Name="PnlGpuBadgeDigits" Margin="28,0,0,8">
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="126"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_TrayBadgeMetric}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbGpuBadgeMetric" Grid.Column="1" Width="126" HorizontalAlignment="Left" Style="{StaticResource SettingsMiniComboStyle}" SelectionChanged="CmbTrayBadgeMetric_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Settings_TrayBadgeMetricTemperature}" Tag="Temperature"/>
                                <ComboBoxItem Content="{DynamicResource Settings_TrayBadgeMetricLoad}" Tag="Load"/>
                                <ComboBoxItem Content="{DynamicResource Settings_TrayBadgeMetricRam}" Tag="Ram"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <RadioButton x:Name="RdoGpuBlackDigits" GroupName="GpuTrayDigits" Style="{StaticResource SettingsRadioButtonStyle}" Content="{DynamicResource Settings_BlackDigits}" Checked="SettingChanged"/>
                            <Border Width="22" Height="20" Background="#B3D872" CornerRadius="1" Margin="10,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
                                <TextBlock x:Name="TxtSampleGpuBlack" Text="--" Foreground="#141414" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <RadioButton x:Name="RdoGpuWhiteDigits" GroupName="GpuTrayDigits" Style="{StaticResource SettingsRadioButtonStyle}" Content="{DynamicResource Settings_WhiteDigits}" Checked="SettingChanged"/>
                            <Border Width="22" Height="20" Background="#4C8028" CornerRadius="1" Margin="10,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
                                <TextBlock x:Name="TxtSampleGpuWhite" Text="--" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox x:Name="ChkShowCpuBadge" Content="{DynamicResource Settings_ShowCpuBadge}" Checked="ChkTrayBadge_Changed" Unchecked="ChkTrayBadge_Changed" Margin="0,6,0,6"/>
                    <StackPanel x:Name="PnlCpuBadgeDigits" Margin="28,0,0,8">
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="126"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_TrayBadgeMetric}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbCpuBadgeMetric" Grid.Column="1" Width="126" HorizontalAlignment="Left" Style="{StaticResource SettingsMiniComboStyle}" SelectionChanged="CmbTrayBadgeMetric_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Settings_TrayBadgeMetricTemperature}" Tag="Temperature"/>
                                <ComboBoxItem Content="{DynamicResource Settings_TrayBadgeMetricLoad}" Tag="Load"/>
                                <ComboBoxItem Content="{DynamicResource Settings_TrayBadgeMetricRam}" Tag="Ram"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <RadioButton x:Name="RdoCpuBlackDigits" GroupName="CpuTrayDigits" Style="{StaticResource SettingsRadioButtonStyle}" Content="{DynamicResource Settings_BlackDigits}" Checked="SettingChanged"/>
                            <Border Width="22" Height="20" Background="#FFBDAF" CornerRadius="1" Margin="10,0,4,0" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
                                <TextBlock x:Name="TxtSampleCpuOffBlack" Text="--" Foreground="#141414" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="22" Height="20" Background="#8AD2F1" CornerRadius="1" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
                                <TextBlock x:Name="TxtSampleCpuOnBlack" Text="--" Foreground="#141414" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <RadioButton x:Name="RdoCpuWhiteDigits" GroupName="CpuTrayDigits" Style="{StaticResource SettingsRadioButtonStyle}" Content="{DynamicResource Settings_WhiteDigits}" Checked="SettingChanged"/>
                            <Border Width="22" Height="20" Background="#C44830" CornerRadius="1" Margin="10,0,4,0" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
                                <TextBlock x:Name="TxtSampleCpuOffWhite" Text="--" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="22" Height="20" Background="#1B6CB3" CornerRadius="1" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
                                <TextBlock x:Name="TxtSampleCpuOnWhite" Text="--" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox x:Name="ChkMergeTrayIcons" Content="{DynamicResource Settings_MergeTrayIcons}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,4,0,0"/>

                    <TextBlock Text="{DynamicResource Settings_FrameColorsHeader}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_ColorCoolingOn}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnColorCoolingOn"
                                    Style="{StaticResource ColorSwatchButtonStyle}"
                                    Background="#2B88D8"
                                    Click="BtnColorCoolingOn_Click"
                                    AutomationProperties.Name="{DynamicResource Settings_ColorCoolingOn}"/>
                            <Button x:Name="BtnResetColorCoolingOn"
                                    Content="↺"
                                    Style="{StaticResource SettingsFooterButton}"
                                    Padding="6,2"
                                    Margin="6,0,0,0"
                                    Click="BtnResetColorCoolingOn_Click"
                                    ToolTip="{DynamicResource Settings_ResetColorTooltip}"
                                    AutomationProperties.Name="{DynamicResource Settings_ResetColorTooltip}"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_ColorCoolingOff}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnColorCoolingOff"
                                    Style="{StaticResource ColorSwatchButtonStyle}"
                                    Background="#C26A47"
                                    Click="BtnColorCoolingOff_Click"
                                    AutomationProperties.Name="{DynamicResource Settings_ColorCoolingOff}"/>
                            <Button x:Name="BtnResetColorCoolingOff"
                                    Content="↺"
                                    Style="{StaticResource SettingsFooterButton}"
                                    Padding="6,2"
                                    Margin="6,0,0,0"
                                    Click="BtnResetColorCoolingOff_Click"
                                    ToolTip="{DynamicResource Settings_ResetColorTooltip}"
                                    AutomationProperties.Name="{DynamicResource Settings_ResetColorTooltip}"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Settings_WindowDocking}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,10"/>
                    <CheckBox x:Name="ChkAnchorToTray" Content="{DynamicResource Settings_AnchorToTray}" Checked="SettingChanged" Unchecked="SettingChanged"/>

                    <TextBlock Text="{DynamicResource Settings_DashboardRows}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,10"/>
                    <CheckBox x:Name="ChkShowRamRow" Content="{DynamicResource Settings_ShowRamRow}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowOverlayRow" Content="{DynamicResource Settings_ShowOverlayRow}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowAutopilotRow" Content="{DynamicResource Settings_ShowAutopilotRow}" Checked="SettingChanged" Unchecked="SettingChanged"/>

                    <TextBlock Text="{DynamicResource Settings_OverlayReadouts}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4"/>
                    <TextBlock Text="{DynamicResource Settings_OverlayReadoutsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkOverlayClickThrough" Content="{DynamicResource Settings_OverlayClickThrough}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,2,0,2"/>
                    <TextBlock Text="{DynamicResource Settings_OverlayClickThroughHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,10"/>
                    <TextBlock Text="{DynamicResource Settings_OverlayOpacity}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldOverlayOpacity"
                                Minimum="0"
                                Maximum="100"
                                Value="90"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SldOverlayOpacity_ValueChanged"
                                AutomationProperties.Name="{DynamicResource Settings_OverlayOpacity}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtOverlayOpacity" Text="90%" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Settings_OverlayOpacityDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkOverlayCpuTemp" Content="{DynamicResource Settings_OverlayCpuTemp}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkOverlayCpuLoad" Content="{DynamicResource Settings_OverlayCpuLoad}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkOverlayCpuPower" Content="{DynamicResource Settings_OverlayCpuPower}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkOverlayCpuClock" Content="{DynamicResource Settings_OverlayCpuClock}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkOverlayGpuTemp" Content="{DynamicResource Settings_OverlayGpuTemp}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,4,0,0"/>
                    <CheckBox x:Name="ChkOverlayGpuLoad" Content="{DynamicResource Settings_OverlayGpuLoad}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkOverlayGpuPower" Content="{DynamicResource Settings_OverlayGpuPower}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkOverlayShowRam" Content="{DynamicResource Settings_OverlayShowRam}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <StackPanel x:Name="PnlBatterySetting" Margin="0,10,0,0">
                        <CheckBox x:Name="ChkShowBatteryStatus" Content="{DynamicResource Settings_ShowBatteryStatus}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <TextBlock Text="{DynamicResource Settings_ShowBatteryStatusDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,2,0,6"/>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Settings_DashboardReadouts}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,10"/>
                    <CheckBox x:Name="ChkShowCpuPower" Content="{DynamicResource Settings_ShowCpuPower}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowGpuPower" Content="{DynamicResource Settings_ShowGpuPower}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowGpuTemp" Content="{DynamicResource Settings_ShowGpuTemp}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowGpuName" Content="{DynamicResource Settings_ShowGpuName}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowGpuHotspot" Content="{DynamicResource Settings_ShowGpuHotspot}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowGpuVram" Content="{DynamicResource Settings_ShowGpuVram}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowGpuFan" Content="{DynamicResource Settings_ShowGpuFan}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowGpuDetails" Content="{DynamicResource Settings_ShowGpuDetails}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <TextBlock Text="{DynamicResource Settings_ShowGpuDetailsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,2,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="126"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_GpuGraphMetric}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbGpuGraphMetric"
                                  Grid.Column="1"
                                  Width="126"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource SettingsMiniComboStyle}"
                                  SelectionChanged="CmbGpuGraphMetric_SelectionChanged"
                                  AutomationProperties.Name="{DynamicResource Settings_GpuGraphMetric}">
                            <ComboBoxItem Content="{DynamicResource Settings_GpuGraphTemperature}" Tag="Temperature" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource Settings_GpuGraphPower}" Tag="Power"/>
                            <ComboBoxItem Content="{DynamicResource Settings_GpuGraphLoad}" Tag="Load"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="{DynamicResource Settings_SystemInfoReadouts}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,10"/>
                    <CheckBox x:Name="ChkShowFanSpeeds" Content="{DynamicResource Settings_ShowFanSpeeds}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <TextBlock Text="{DynamicResource Settings_ShowFanSpeedsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- CPU TAB -->
                <StackPanel x:Name="PanelCpu" Visibility="Collapsed">
                    <CheckBox x:Name="ChkShowCpuClock" Content="{DynamicResource Settings_ShowCpuClock}" Checked="ChkCpuDisplay_Changed" Unchecked="ChkCpuDisplay_Changed" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkShowCpuBaseSpeed" Content="{DynamicResource Settings_ShowCpuBaseSpeed}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="28,0,0,10"/>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkShowCpuGraph" Grid.Column="0" Content="{DynamicResource Settings_ShowCpuGraph}" Checked="ChkCpuDisplay_Changed" Unchecked="ChkCpuDisplay_Changed" Margin="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbCpuGraphTimeframe"
                                  Grid.Column="1"
                                  Style="{StaticResource SettingsMiniComboStyle}"
                                  Margin="10,0,0,0"
                                  SelectionChanged="CmbCpuGraphTimeframe_SelectionChanged"
                                  AutomationProperties.Name="{DynamicResource Settings_ShowCpuGraph}">
                            <ComboBoxItem Content="{DynamicResource Main_Timeframe1}" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource Main_Timeframe5}" Tag="5"/>
                            <ComboBoxItem Content="{DynamicResource Main_Timeframe10}" Tag="10"/>
                            <ComboBoxItem Content="{DynamicResource Main_Timeframe30}" Tag="30"/>
                            <ComboBoxItem Content="{DynamicResource Main_Timeframe60}" Tag="60"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="PnlCpuGraphSize" Margin="28,2,0,6">
                        <RadioButton x:Name="RdoCpuGraphLarge" GroupName="CpuGraphSize" Style="{StaticResource SettingsRadioButtonStyle}" Content="{DynamicResource Settings_GraphLarge}" Checked="SettingChanged"/>
                        <RadioButton x:Name="RdoCpuGraphSmall" GroupName="CpuGraphSize" Style="{StaticResource SettingsRadioButtonStyle}" Content="{DynamicResource Settings_GraphSmall}" Checked="SettingChanged"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,10,0,16"/>

                    <TextBlock Text="{DynamicResource Settings_PowerPlanOff}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Settings_PowerPlanDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,10"/>
                    <ComboBox x:Name="CmbNormalPowerPlan"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Guid"
                              AutomationProperties.Name="{DynamicResource Settings_PowerPlanOff}"
                              SelectionChanged="CmbNormalPowerPlan_SelectionChanged"/>
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,18,0,18"/>

                    <TextBlock Text="{DynamicResource Settings_CoolingControls}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Settings_CoolingControlsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,14"/>

                    <!-- Processor Performance Boost Mode (PERFBOOSTMODE) -->
                    <TextBlock Text="{DynamicResource Settings_BoostMode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPerfBoostMode" Margin="0,0,0,16" SelectionChanged="CmbPerfBoostMode_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Settings_BoostDisabled}" IsSelected="True"/>
                        <ComboBoxItem Content="{DynamicResource Settings_BoostEnabled}"/>
                    </ComboBox>

                    <!-- Maximum Processor State (PROCTHROTTLEMAX) -->
                    <TextBlock Text="{DynamicResource Settings_MaxProcessor}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldThrottle" Minimum="50" Maximum="100" Value="99" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldThrottle_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="TxtThrottleVal" Text="99%" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,4,0,14"/>

                    <TextBlock Text="{DynamicResource Settings_CpuAlertThreshold}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldCpuThreshold" Minimum="60" Maximum="100" Value="85" ValueChanged="SldCpuThreshold_ValueChanged" AutomationProperties.Name="{DynamicResource Settings_CpuAlertThreshold}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtCpuThreshold" Text="85°C" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>
                </StackPanel>

                <!-- MEMORY TAB -->
                <StackPanel x:Name="PanelMemory" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Settings_RamCleaningOptions}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Settings_RamCleaningDesc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkRamFreeWorkingSets" Content="{DynamicResource Settings_RamFreeWorkingSets}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,8,0,8"/>
                    <CheckBox x:Name="ChkRamClearStandby" Content="{DynamicResource Settings_RamClearStandby}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,8,0,8"/>
                    <CheckBox x:Name="ChkRamClearClipboard" Content="{DynamicResource Settings_RamClearClipboard}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,8,0,8"/>
                    <CheckBox x:Name="ChkRamShowNotification" Content="{DynamicResource Settings_RamShowNotification}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,8,0,8"/>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,12,0,16"/>

                    <TextBlock Text="{DynamicResource Settings_RamAutoHeader}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,10"/>
                    <ToggleButton x:Name="ChkAutoRamEnabled"
                                  Style="{StaticResource AutopilotToggleStyle}"
                                  Content="{DynamicResource Settings_RamAutoEnable}"
                                  Checked="ChkAutoRamEnabled_Changed"
                                  Unchecked="ChkAutoRamEnabled_Changed"/>

                    <TextBlock Text="{DynamicResource Settings_RamAutoThreshold}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,6"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldAutoRamThreshold"
                                Minimum="10"
                                Maximum="50"
                                Value="25"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SldAutoRamThreshold_ValueChanged"
                                AutomationProperties.Name="{DynamicResource Settings_RamAutoThreshold}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtAutoRamThreshold" Text="25%" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Settings_RamAutoCooldownHint}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <CheckBox x:Name="ChkAutoRamCpuIdle" Content="{DynamicResource Settings_RamAutoCpuIdle}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,6,0,10"/>

                    <TextBlock Text="{DynamicResource Settings_RamAutoInterval}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,6"/>
                    <ComboBox x:Name="CmbAutoRamInterval"
                              HorizontalAlignment="Left"
                              Width="180"
                              SelectionChanged="CmbAutoRamInterval_SelectionChanged"
                              AutomationProperties.Name="{DynamicResource Settings_RamAutoInterval}">
                        <ComboBoxItem Content="{DynamicResource Settings_RamIntervalDisabled}" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="{DynamicResource Settings_RamInterval1h}" Tag="1"/>
                        <ComboBoxItem Content="{DynamicResource Settings_RamInterval2h}" Tag="2"/>
                        <ComboBoxItem Content="{DynamicResource Settings_RamInterval4h}" Tag="4"/>
                        <ComboBoxItem Content="{DynamicResource Settings_RamInterval6h}" Tag="6"/>
                    </ComboBox>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,18,0,16"/>

                    <TextBlock Text="{DynamicResource Settings_RamHotkeyHeader}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkUseRamHotkey" Content="{DynamicResource Settings_UseRamHotkey}" Checked="ChkUseRamHotkey_Changed" Unchecked="ChkUseRamHotkey_Changed" Margin="0,8,0,6"/>
                    <StackPanel Margin="28,2,0,0">
                        <TextBox x:Name="TxtRamHotkeyShortcut"
                                 Text="Ctrl + Alt + M"
                                 IsReadOnly="True"
                                 ContextMenu="{x:Null}"
                                 Width="210" Height="30"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 BorderThickness="1"
                                 Padding="8,0"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 HorizontalAlignment="Left"
                                 Cursor="Hand"
                                 AutomationProperties.Name="{DynamicResource Settings_UseRamHotkey}"
                                 GotKeyboardFocus="TxtRamHotkeyShortcut_GotKeyboardFocus"
                                 LostKeyboardFocus="TxtRamHotkeyShortcut_LostKeyboardFocus"
                                 PreviewKeyDown="TxtRamHotkeyShortcut_PreviewKeyDown"/>
                        <TextBlock x:Name="TxtRamHotkeyHint"
                                   Text="{DynamicResource Settings_HotkeyHint}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- DISK TAB -->
                <StackPanel x:Name="PanelDisk" Visibility="Collapsed">
                    <CheckBox x:Name="ChkShowDiskTemp" Content="{DynamicResource Settings_ShowDiskTemp}" Checked="ChkShowDiskTemp_Changed" Unchecked="ChkShowDiskTemp_Changed" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkStorageHealthAlerts" Content="{DynamicResource Settings_StorageHealthAlerts}" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,2"/>
                    <TextBlock Text="{DynamicResource Settings_StorageHealthAlertsDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,14"/>
                    <TextBlock Text="{DynamicResource Settings_StoragePrefs}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Settings_CpuAlertThreshold}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldDiskThreshold" Minimum="40" Maximum="85" Value="60" ValueChanged="SldDiskThreshold_ValueChanged" AutomationProperties.Name="{DynamicResource Settings_CpuAlertThreshold}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtDiskThreshold" Text="60°C" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,2,0,14"/>
                    <TextBlock Text="{DynamicResource Settings_MonitoredDrives}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Settings_MonitoredDrivesDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border x:Name="BdrMonitoredDrives"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <Grid>
                            <TextBlock x:Name="TxtNoDrivesDetected"
                                       Text="{DynamicResource Settings_MonitoredDrivesUnavailable}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="2,8"
                                       Visibility="Collapsed"/>
                            <StackPanel x:Name="PnlDiskDrives"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- GPU TAB -->
                <StackPanel x:Name="PanelGpu" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Settings_GpuPrefs}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Settings_PrimaryGpu}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,4"/>
                    <TextBlock Text="{DynamicResource Settings_PrimaryGpuDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbPrimaryGpu"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Identifier"
                              AutomationProperties.Name="{DynamicResource Settings_PrimaryGpu}"
                              Margin="0,0,0,16"
                              SelectionChanged="CmbPrimaryGpu_SelectionChanged"/>
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,2,0,14"/>
                    <TextBlock Text="{DynamicResource Settings_CpuAlertThreshold}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldGpuThreshold" Minimum="50" Maximum="95" Value="80" ValueChanged="SldGpuThreshold_ValueChanged" AutomationProperties.Name="{DynamicResource Settings_CpuAlertThreshold}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtGpuThreshold" Text="80°C" Foreground="{DynamicResource GpuAccentBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    </Grid>
                </StackPanel>

                <!-- AUTOPILOT TAB -->
                <StackPanel x:Name="PanelAutopilot" Visibility="Collapsed">
                    <ToggleButton x:Name="ChkAutopilotEnabled"
                                  Style="{StaticResource AutopilotToggleStyle}"
                                  Content="{DynamicResource Settings_AutopilotEnable}"
                                  Checked="SettingChanged"
                                  Unchecked="SettingChanged"/>
                    <TextBlock Text="{DynamicResource Settings_AutopilotDesc}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,-4,0,10"/>
                    <CheckBox x:Name="ChkAutopilotFullscreen"
                              Content="{DynamicResource Settings_AutopilotPauseFullscreen}"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"
                              Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkAutopilotForegroundOnly"
                              Content="{DynamicResource Settings_AutopilotForegroundOnly}"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"
                              Margin="0,0,0,2"/>
                    <TextBlock Text="{DynamicResource Settings_AutopilotForegroundOnlyDesc}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="28,0,0,12"/>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource Settings_AutopilotWhitelist}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock x:Name="TxtAutopilotCount"
                                   Text="0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FlowDirection="LeftToRight"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Settings_AutopilotWhitelistDesc}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4"
                            Margin="0,0,0,12">
                        <Grid>
                            <TextBlock x:Name="TxtAutopilotEmpty"
                                       Text="{DynamicResource Settings_AutopilotEmpty}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="8,9"
                                       IsHitTestVisible="False"/>
                            <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlAutopilotWhitelist"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock Text="{DynamicResource Settings_AutopilotAddRunning}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbRunningApps"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{DynamicResource Settings_AutopilotAddRunning}"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                x:Name="BtnAddRunningApp"
                                Content="{DynamicResource Settings_AutopilotAdd}"
                                Click="BtnAddRunningApp_Click"
                                Style="{StaticResource SettingsFooterButton}"/>
                    </Grid>

                    <Button x:Name="BtnBrowseAutopilotApp"
                            Content="{DynamicResource Settings_AutopilotBrowse}"
                            Click="BtnBrowseAutopilotApp_Click"
                            Style="{StaticResource SettingsFooterButton}"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource Settings_AutopilotHint}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- ABOUT TAB -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <Image Source="pack://application:,,,/Images/CryoTray_Logo.png"
                           Width="72" Height="72"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,10"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{DynamicResource App_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Settings_AboutTagline}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtAboutVersion" Text="" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,10,0,0"/>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,18,0,18"/>

                    <TextBlock Text="{DynamicResource Settings_Updates}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Settings_UpdatesDesc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAutomaticUpdates" Content="{DynamicResource Settings_AutomaticUpdates}" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <TextBlock x:Name="TxtUpdateCadence"
                               Text="{DynamicResource Settings_UpdateCadence}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,4"/>
                    <CheckBox x:Name="ChkSaveRollbackOnUpdate"
                              Content="{DynamicResource Settings_SaveRollbackOnUpdate}"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>
                    <TextBlock Text="{DynamicResource Settings_SaveRollbackOnUpdateDesc}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtUpdateStatus"
                               Text="{DynamicResource Settings_UpdateDefault}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MinHeight="34"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="TxtUpdateLastChecked"
                               Text="{DynamicResource Settings_LastCheckedNever}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <Border x:Name="PnlUpdateNotes"
                            Visibility="Collapsed"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,6"
                            MaxHeight="150">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_WhatsNew}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110">
                                <TextBlock x:Name="TxtUpdateNotes"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button x:Name="BtnUpdate"
                                Content="{DynamicResource Settings_CheckUpdates}"
                                Click="BtnUpdate_Click"
                                Style="{StaticResource SettingsFooterButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"/>
                        <Button x:Name="BtnCancelUpdate"
                                Content="{DynamicResource Settings_CancelUpdate}"
                                Click="BtnCancelUpdate_Click"
                                Style="{StaticResource SettingsFooterButton}"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"/>
                        <Button x:Name="BtnClearDownloads"
                                Content="{DynamicResource Settings_ClearDownloads}"
                                Click="BtnClearDownloads_Click"
                                Style="{StaticResource SettingsFooterButton}"
                                FontSize="11.5"
                                Padding="9,4"
                                HorizontalAlignment="Left"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="{DynamicResource Settings_DownloadCacheClearTooltip}"
                                AutomationProperties.Name="{DynamicResource Settings_ClearDownloads}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDownloadCacheStatus"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="TxtRollbackStatus"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="BtnRollback"
                                Content="{DynamicResource Settings_RollbackButton}"
                                Click="BtnRollback_Click"
                                Style="{StaticResource SettingsFooterButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"/>
                        <Button x:Name="BtnDeleteRollback"
                                Content="{DynamicResource Settings_RollbackDeleteButton}"
                                Click="BtnDeleteRollback_Click"
                                Style="{StaticResource SettingsFooterButton}"
                                FontSize="11.5"
                                Padding="9,4"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                ToolTip="{DynamicResource Settings_RollbackDeleteConfirmTitle}"
                                AutomationProperties.Name="{DynamicResource Settings_RollbackDeleteButton}"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,20,0,18"/>

                    <TextBlock Text="{DynamicResource Settings_Author}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Settings_Copyright}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{DynamicResource Settings_License}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap">
                        <Run Text="{DynamicResource Settings_RepositoryLabel}"/>
                        <Hyperlink Foreground="{DynamicResource RamAccentBrush}"
                                   TextDecorations="Underline"
                                   Cursor="Hand"
                                   Click="RepoLink_Click"
                                   ToolTip="https://github.com/ZerroDevs/CryoTray"
                                   AutomationProperties.Name="{DynamicResource Settings_RepositoryAutomation}">https://github.com/ZerroDevs/CryoTray</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnExport" Click="BtnExport_Click" Style="{StaticResource SettingsFooterButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M6,12 L6,2 M2,6 L6,2 L10,6" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_Export}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnImport" Click="BtnImport_Click" Style="{StaticResource SettingsFooterButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M6,2 L6,12 M2,8 L6,12 L10,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Settings_Import}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="BtnReset" Click="BtnReset_Click" Style="{StaticResource SettingsFooterButton}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M2,7 A4,4 0 1,1 4,11 M2,7 L2,3 M2,7 L6,7" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Settings_Reset}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
    </Border>
</Window>
